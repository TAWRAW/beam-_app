# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin simple auth
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password
SESSION_SECRET=your_session_secret

# Google Tag Manager & Analytics (REQUIRED FOR PRODUCTION)
NEXT_PUBLIC_GTM_ID=GTM-MWPLJBQP
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GNFWQBSW2F

# Google Search Console (Optional - for meta tag verification)
# GOOGLE_SITE_VERIFICATION=your_verification_code

# On-Demand Revalidation API (REQUIRED FOR AUTO-REVALIDATION)
# Token secret pour sécuriser l'API /api/revalidate
# Utilisé par le workflow n8n pour revalider les pages après modification d'articles
# Générer avec: openssl rand -base64 32
REVALIDATION_TOKEN=your_secret_token_here
