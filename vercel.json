{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "next build",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "crons": [
    { "path": "/api/rapport-comptable", "schedule": "30 5 * * 1-5" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "xn--beam-yqa.fr" }
      ],
      "destination": "https://www.xn--beam-yqa.fr/:path*",
      "permanent": true
    }
  ]
}
